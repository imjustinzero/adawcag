generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccessibilityCertification {
  id          String   @id @default(cuid())
  tenantId    String
  status      String   @default("active")
  expiresAt   DateTime
  renewedAt   DateTime?
  stripeSubId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InstallEvent {
  id        String   @id @default(cuid())
  tenantId  String?
  source    String
  version   String?
  userAgent String?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([source])
  @@index([createdAt])
}

model Billing {
  id         String   @id @default(cuid())
  customerId String   @unique
  active     Boolean  @default(false)
  plan       String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Scan {
  id            String   @id @default(cuid())
  failedAt      DateTime?
  failureReason String?
}

model Certificate {
  id             String   @id @default(cuid())
  tenantId       String
  siteId         String
  scanId         String
  score          Int
  issuedAt       DateTime @default(now())
  expiresAt      DateTime
  status         String   @default("conditional")
  type           String   @default("WCAG_2_1_AA")
  certNumber     String   @unique
  countersignedBy String?
  countersignedAt DateTime?
  createdAt      DateTime @default(now())
}

model TenantOverride {
  id            String   @id @default(cuid())
  tenantId      String
  pageLimit     Int?
  sitesAllowed  Int?
  scanFrequency String?
  expiresAt     DateTime?
  reason        String?
  createdBy     String?
  createdAt     DateTime @default(now())
}
