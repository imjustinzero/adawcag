generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccessibilityCertification {
  id           String   @id @default(cuid())
  tenantId      String
  status        String   @default("active")
  expiresAt     DateTime
  renewedAt     DateTime?
  stripeSubId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model InstallEvent {
  id        String   @id @default(cuid())
  tenantId  String?
  source    String
  version   String?
  userAgent String?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([source])
  @@index([createdAt])
}
